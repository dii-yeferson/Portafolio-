{
  "name": "portafolio-di-yeferson",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio profesional y CMS headless de Di Yeferson — Big Data · Ciencia de Datos · IA Aplicada.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typegen": "sanity schema extract --force && sanity typegen generate",
    "seed": "sanity exec scripts/seed.ts --with-user-token",
    "check": "npm run lint && npm run typecheck && npm run format:check && npm run test",
    "globe:generate": "node scripts/generate-globe-mask.mjs"
  },
  "dependencies": {
