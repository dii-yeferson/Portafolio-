    "@sanity/vision": "^6.22.0",
    "groq": "^6.22.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.69.0",
    "motion": "^14.9.1",
    "next": "^16.4.5",
    "next-sanity": "^13.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanity": "^6.22.0",
    "server-only": "^0.0.1",
