    "@types/topojson-client": "^3.1.5",
    "d3-geo": "^3.1.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.5",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.4",
    "topojson-client": "^3.1.0",
    "typescript": "~7.0.2",
