# ─────────────────────────────────────────────────────────────
# Copia este archivo a `.env.local` y completa los valores.
# Nunca subas `.env.local` al repositorio.
# ─────────────────────────────────────────────────────────────

# URL pública canónica del sitio (sin barra final). Se usa en SEO,
# Open Graph, sitemap y robots. En Vercel se usa como respaldo
# VERCEL_PROJECT_PRODUCTION_URL si no se define.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Sanity (https://www.sanity.io/manage) ────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Fecha fija de la API de Sanity (AAAA-MM-DD). No usar fechas futuras.
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Secreto compartido con el webhook de Sanity → /api/revalidate
# Genera uno con: openssl rand -hex 32
SANITY_REVALIDATE_SECRET=

# ── Formulario de contacto (opcional) ────────────────────────
# Sin estas variables, /api/contact responde 503 y la interfaz
# ofrece el enlace mailto: como alternativa.
RESEND_API_KEY=
# Remitente verificado en Resend, p. ej. "Portafolio <hola@tudominio.com>"
CONTACT_FROM_EMAIL=
# Destinatario. Si se omite, se usa `contactEmail` de Configuración del sitio.
CONTACT_TO_EMAIL=
